{
  "name": "framo",
  "version": "0.4.0",
  "private": true,
  "description": "An agent-powered desktop video studio",
  "type": "module",
  "main": "dist/main/main.js",
  "author": "ItsToddx",
  "license": "Apache-2.0",
  "engines": {
    "node": ">=22.13"
  },
  "scripts": {
    "dev": "node scripts/dev.mjs",
    "build": "tsc --noEmit && node scripts/build.mjs && vite build",
    "typecheck": "tsc --noEmit",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:desktop": "tsx scripts/desktop-smoke.ts",
    "test:desktop-failures": "tsx scripts/desktop-failures.ts",
    "test:desktop-generated": "tsx scripts/desktop-generated.ts",
    "start": "electron .",
    "package": "npm run build && electron-builder --mac dir",
    "dist:mac": "npm run build && npm --prefix packages/kit-sdk run build && mkdir -p release && npm pack ./packages/kit-sdk --pack-destination release && node scripts/dist-mac.mjs",
    "check": "npm run typecheck && npm test && npm run build",
    "media:build": "sh scripts/build-media.sh",
    "format": "prettier --write apps packages tests scripts docs *.json *.ts *.md",
    "format:check": "prettier --check apps packages tests scripts docs *.json *.ts *.md",
    "test:desktop-ui": "tsx scripts/desktop-ui.ts",
    "test:desktop-languages": "tsx scripts/desktop-languages.ts",
    "test:desktop-canvas": "tsx scripts/desktop-canvas-first.ts"
  },
  "dependencies": {
    "@assistant-ui/react": "0.15.28",
    "@mariozechner/pi-agent-core": "0.73.1",
    "@mariozechner/pi-ai": "0.73.1",
    "@napi-rs/canvas": "1.0.11",
    "@radix-ui/react-dialog": "1.3.1",
    "@radix-ui/react-tabs": "1.2.1",
    "@radix-ui/react-tooltip": "1.4.1",
    "@sinclair/typebox": "0.34.41",
    "@xyflow/react": "12.10.0",
    "adm-zip": "0.6.1",
    "ajv": "8.20.0",
    "class-variance-authority": "0.7.1",
    "clsx": "2.1.1",
    "lucide-react": "0.577.0",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "react-markdown": "10.1.0",
    "remark-gfm": "4.0.1",
    "tailwind-merge": "3.7.0",
    "zod": "4.3.6"
  },
  "devDependencies": {
    "@playwright/test": "1.58.2",
    "@tailwindcss/vite": "4.3.3",
    "@types/adm-zip": "0.5.8",
    "@types/node": "24.12.0",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "electron": "44.7.0",
    "electron-builder": "26.15.3",
    "esbuild": "0.28.2",
    "prettier": "3.9.10",
    "tailwindcss": "4.3.3",
    "tsx": "4.21.0",
    "typescript": "5.9.3",
    "vite": "7.3.7"
  },
  "build": {
    "appId": "com.reelbeam.desktop",
    "productName": "Framo",
    "directories": {
      "output": "release"
    },
    "files": [
      "dist/**/*",
      "package.json"
    ],
    "asar": true,
    "mac": {
      "category": "public.app-category.video",
      "icon": "resources/icon.icns",
      "target": [
        "zip",
        "dmg"
      ],
      "identity": null
    },
    "artifactName": "Framo-${version}-${arch}.${ext}",
    "npmRebuild": false,
    "extraResources": [
      {
        "from": "resources/bin",
        "to": "bin"
      },
      {
        "from": "resources/licenses",
        "to": "licenses"
      }
    ]
  },
  "overrides": {
    "tar": "7.5.22",
    "basic-ftp": "6.2.3",
    "esbuild": "0.28.2"
  }
}
