    {
      "id": "reelbeam.caption-style",
      "name": "Caption styling",
      "kind": "edit",
      "description": "Propose a uniform style for selected captions.",
      "permissions": [
        "project.read",
        "project.propose"
      ],
      "inputSchema": {
        "$schema": "https://json-schema.org/draft/2020-12/schema",
        "type": "object",
        "properties": {
          "captionIds": {
            "minItems": 1,
            "maxItems": 200,
            "type": "array",
            "items": {
              "type": "string"
            }
          },
          "fontSize": {
            "type": "number",
            "minimum": 12,
            "maximum": 120
          },
          "color": {
            "type": "string",
            "pattern": "^#[0-9a-fA-F]{6}$"
          },
          "position": {
            "type": "string",
            "enum": [
              "top",
              "center",
              "bottom"
            ]
          }
        },
        "required": [
          "captionIds",
          "fontSize",
          "color",
          "position"
        ],
        "additionalProperties": false
      },
      "outputSchema": {
        "type": "object"
      }
    },
