  "agents": [
    {
      "descriptor": {
        "id": "reelbeam.creative",
        "name": "Creative director",
        "kind": "agent",
        "description": "Plans scripts, structure and shot intent.",
        "permissions": [
          "project.read",
          "model.infer"
        ],
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "role": "creative",
      "systemPrompt": "You are Reelbeam’s creative director. Develop a concise script and shot plan from the user goal. Read the project before naming assets. Return concrete shot intent, duration, visual style, and reusable reference IDs. Never claim a video has been generated.",
      "tools": [
        "read_project",
        "inspect_media"
      ]
    },
    {
      "descriptor": {
        "id": "reelbeam.visual",
        "name": "Visual producer",
        "kind": "agent",
        "description": "Selects image references and prepares Seedance generation proposals.",
        "permissions": [
          "project.read",
          "project.propose",
          "model.infer",
          "seedance.generate"
        ],
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "role": "visual",
      "systemPrompt": "You are Reelbeam’s visual producer. Use Seedance only. Read the project, inspect actual image references and generated frames, select registered reference image IDs, and propose exact prompts, durations, ratios and estimated costs for review. A generation proposal requires user acceptance and does not mean a cloud task exists. Reuse adopted assets instead of regenerating a whole sequence.",
      "tools": [
        "read_project",
        "inspect_media",
        "propose_generation"
      ]
    },
    {
      "descriptor": {
        "id": "reelbeam.editor",
        "name": "Film editor",
        "kind": "agent",
        "description": "Prepares revision-aware timeline and caption changes.",
        "permissions": [
          "project.read",
          "project.propose",
          "model.infer"
        ],
        "inputSchema": {
          "type": "object"
        },
        "outputSchema": {
          "type": "object"
        }
      },
      "role": "editor",
      "systemPrompt": "You are Reelbeam’s film editor. Read the current sequence revision and exact asset IDs. Inspect actual source frames and audio measurements before making quality claims. Prepare precise edit commands preserving unrelated clips, captions and music. Every edit is a proposal with expectedRevision. Imported and generated assets may be edited. Never invent assets or claim a proposal was accepted.",
      "tools": [
        "read_project",
        "inspect_media",
        "propose_edit"
      ]
    }
  ],
  "recipe": {
    "descriptor": {
      "id": "reelbeam.product-ad",
      "name": "Product film",
      "kind": "recipe",
      "description": "Create a product ad through script, visual generation review, and timeline assembly.",
      "permissions": [
        "project.read",
        "project.propose",
        "model.infer",
        "seedance.generate"
      ],
      "inputSchema": {
        "type": "object"
      },
      "outputSchema": {
        "type": "object"
      }
    },
    "steps": [
      {
        "id": "script",
        "title": "Script and shot plan",
        "capabilityId": "reelbeam.creative",
        "role": "creative",
        "dependsOn": [],
        "input": {
          "brief": {
            "from": "input",
            "pointer": "/brief"
          }
        },
        "reviewBefore": false,
        "reviewAfter": true
      },
      {
        "id": "visuals",
        "title": "Prepare Seedance shots",
        "capabilityId": "reelbeam.visual",
        "role": "visual",
        "dependsOn": [
          "script"
        ],
        "input": {
          "plan": {
            "from": "step",
            "stepId": "script",
            "pointer": "/value"
          }
        },
        "reviewBefore": true,
        "reviewAfter": true
      },
      {
        "id": "assembly",
        "title": "Assemble and caption",
        "capabilityId": "reelbeam.editor",
        "role": "editor",
        "dependsOn": [
          "script",
          "visuals"
        ],
        "input": {
          "plan": {
            "from": "step",
            "stepId": "script",
            "pointer": "/value"
          },
          "visuals": {
            "from": "step",
            "stepId": "visuals",
            "pointer": "/artifacts"
          }
        },
        "reviewBefore": true,
        "reviewAfter": true
      }
    ],
    "outputs": {
      "film": {
        "from": "step",
        "stepId": "assembly",
        "pointer": "/value"
      }
    }
  },
