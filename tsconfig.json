{
  "compilerOptions": {
    "target": "ES2022", "module": "ESNext", "moduleResolution": "Bundler",
    "lib": ["ES2023", "DOM", "DOM.Iterable"], "jsx": "react-jsx",
    "strict": true, "skipLibCheck": true, "allowSyntheticDefaultImports": true,
    "esModuleInterop": true, "resolveJsonModule": true, "noEmit": true,
    "types": ["node", "vite/client"]
  },
  "include": ["apps", "packages", "kits", "tests", "scripts", "vite.config.ts"]
}
